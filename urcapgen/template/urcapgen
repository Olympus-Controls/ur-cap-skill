#!/usr/bin/env python3
"""./urcapgen <command> — this monorepo's vendored urcapgen (tools/urcapgen). `./urcapgen -h`."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "tools"))
sys.dont_write_bytecode = True

from urcapgen.cli import main  # noqa: E402

raise SystemExit(main())
